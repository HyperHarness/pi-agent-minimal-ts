FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BOT_ALIASES=Hermes,物理之神

BRIDGE_LEARN_FROM_ALL_GROUP_MESSAGES=true
BRIDGE_HISTORY_LIMIT=20
BRIDGE_LONG_TERM_MEMORY_ENABLED=true
BRIDGE_WEB_SEARCH_ENABLED=true
BRIDGE_WEB_SEARCH_MAX_RESULTS=7

# By default npm run feishu-bridge starts this repo's dist/src/pi-agent.js in RPC mode.
# Set PI_COMMAND only when you want to point the bridge at another compatible agent.
# PI_COMMAND=pi
# PI_AGENT_ENTRY=dist/src/pi-agent.js
PI_USE_SESSION=true
PI_SESSION_DIR=.memory/pi-sessions

FEISHU_STREAM_MODE=card_to_text
FEISHU_STREAM_UPDATES=true
FEISHU_REPLY_TO_MESSAGE=true
