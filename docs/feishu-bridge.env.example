FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BOT_ALIASES=Hermes,物理之神

BRIDGE_LEARN_FROM_ALL_GROUP_MESSAGES=true
BRIDGE_HISTORY_LIMIT=20
BRIDGE_LONG_TERM_MEMORY_ENABLED=true
# Default false: do not feed the agent's previous replies back into prompt history.
BRIDGE_INCLUDE_AGENT_MESSAGES_IN_HISTORY=false
BRIDGE_WEB_SEARCH_ENABLED=true
BRIDGE_WEB_SEARCH_MAX_RESULTS=7

# By default npm run feishu-bridge starts this repo's dist/src/pi-agent.js in RPC mode.
# Set PI_COMMAND only when you want to point the bridge at another compatible agent.
# PI_COMMAND=pi
# PI_AGENT_ENTRY=dist/src/pi-agent.js
PI_USE_SESSION=true
PI_SESSION_DIR=.memory/pi-sessions

FEISHU_STREAM_MODE=card_to_text
FEISHU_STREAM_UPDATES=true
FEISHU_REPLY_TO_MESSAGE=true
# Final replies longer than this are split into numbered text messages.
FEISHU_MAX_REPLY_CHARS=4000
# Upload and send PDFs returned by successful download_paper calls to the current Feishu chat.
FEISHU_SEND_DOWNLOADED_PDF=true
FEISHU_MAX_PDF_UPLOAD_MB=30

# Optional bridge-side paper Git management. Commands are handled before the wiki agent:
#   论文 git status
#   论文 git diff
#   论文 git log
#   论文 git commit 更新说明
BRIDGE_PAPER_WORKSPACE_DIR=paper-projects/million-superconducting-qubits
# Used by bridge-side commands such as "把编译后的论文发给我".
BRIDGE_PAPER_COMPILED_PDF_PATH=manuscript/main.pdf
BRIDGE_PAPER_GIT_ENABLED=true
BRIDGE_PAPER_GIT_MAX_OUTPUT_CHARS=6000
# When enabled, the bridge snapshots the paper repo before a wiki-agent turn.
# If the repo was clean and the agent leaves changes, it commits them and optionally pushes.
BRIDGE_PAPER_GIT_AUTO_COMMIT=false
BRIDGE_PAPER_GIT_AUTO_PUSH=false
